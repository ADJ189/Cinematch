{
  // The Worker name is also the workers.dev subdomain
  // (https://moodsift.adj189.workers.dev). `wrangler deploy` matches on
  // name, so a Worker with this name needs VITE_TMDB_TOKEN (and optionally
  // VITE_OMDB_KEY) set as build variables of its own — renaming creates a
  // new, unconfigured Worker rather than updating the old one.
  "name": "moodsift",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Optional: enables env.AI in worker/index.ts for a server-side
  // re-ranking pass on top of the client-side TMDB pool. The app works
  // fully without this. If you enable it, you must ALSO turn on the AI
  // binding in the Cloudflare dashboard for this Worker (Settings ->
  // Bindings -> AI) — declaring it here alone is not enough, which was
  // the root cause of the old app's silent fallback.
  "ai": {
    "binding": "AI"
  },
  // Optional but recommended once the AI binding is on: per-IP rate limit
  // for POST /api/recommend. worker/index.ts uses env.RECOMMEND_LIMITER
  // only if it exists, so leaving this commented out is safe.
  //
  // "ratelimits": [
  //   { "name": "RECOMMEND_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  // ],
  "observability": {
    "enabled": true
  }
}

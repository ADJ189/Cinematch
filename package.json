{
  "name": "cinematch",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "CineMatch \u2014 a fast, framework-free movie & TV recommendation engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
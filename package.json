{
  "name": "cinematch",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "CineMatch \u2014 a fast, framework-free movie & TV recommendation engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lhci": "lhci autorun",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@lhci/cli": "^0.14.0",
    "eslint": "^9.20.0",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.2.0",
    "wrangler": "^4.121.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
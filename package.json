{
  "name": "cinematch",
  "version": "1.10.2",
  "private": true,
  "type": "module",
  "description": "CineMatch \u2014 a fast, framework-free movie & TV recommendation engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lhci": "npx --yes @lhci/cli autorun",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:visual": "VISUAL=1 playwright test --project=chromium-desktop visual.spec.ts",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "@types/node": "22.15.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "undici": "7.30.0",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0"
  }
}
